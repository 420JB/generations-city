{
  "name": "generations-city",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "families:derive": "node scripts/derive-transparent-families.mjs",
    "dev:server": "tsx watch --env-file-if-exists=.env server/src/main.ts",
    "typecheck:server": "tsc -p server/tsconfig.json",
    "build:server": "tsc -p server/tsconfig.json && vite build --config server/vite.config.ts",
    "start:server": "node dist-server/main.js",
    "db:migrate": "node dist-server/migrate.js",
    "db:migrate:dev": "tsx --env-file-if-exists=.env server/src/migrate-cli.ts",
    "test:server": "vitest run --config server/vitest.config.ts"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  }
}
