# Rare City environment — copy to .env for local server work. Never commit a real .env.
#
# The demo client (npm run dev / npm run build) needs NONE of these.

# --- Server (npm run dev:server, npm run start:server) ---------------------------------

# Which city this process serves: local | staging | production.
# Defaults to local, except that a process with NODE_ENV=production must set it explicitly.
APP_MODE=local

# HTTP port. Railway injects its own.
PORT=8787

# Postgres connection string. Optional in local mode, required in staging and production.
# Also used by `npm run db:migrate` and `npm run city:seed-demo -- --non-canonical`.
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/rarecity

# The one origin browsers reach the server at. Sign-in messages name it and every POST must
# come from it. REQUIRED (https://) in staging and production; defaults to
# http://<HOST>:<PORT> in local mode.
# PUBLIC_ORIGIN=http://127.0.0.1:8787

# Robinhood Chain RPC endpoint for reading Rare Friend ownership. Defaults to the public
# RPC. May contain provider credentials: never commit a real one. It is never logged.
# ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Where ownership is read from: robinhood (default) | fixture. The fixture is a labelled,
# deterministic stand-in and is refused unless APP_MODE=local.
# OWNERSHIP_PROVIDER=robinhood

# --- Tests (npm run test:server, npm run test:e2e:server) -------------------------------

# Disposable database for migration tests. Its name must end in _test and it must not be
# DATABASE_URL. Without it the database tests skip (or fail, with REQUIRE_DB_TESTS=1).
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/rarecity_test

# --- Client build -----------------------------------------------------------------------

# local-demo (default): the engine and the city live in the browser.
# server: the browser reads the shared city from the service. `npm run build:app` sets this
# itself; do not put it in .env, or `npm run dev` and `npm run build` stop being the demo.
# VITE_APP_MODE=local-demo
