# Rare City environment — copy to .env for local server work. Never commit a real .env.
#
# The demo client (npm run dev / npm run build) needs NONE of these.

# --- Server (npm run dev:server, npm run start:server) ---------------------------------

# Which city this process serves: local | staging | production.
# Defaults to local, except that a process with NODE_ENV=production must set it explicitly.
APP_MODE=local

# HTTP port. Railway injects its own.
PORT=8787

# Postgres connection string. Optional in local mode, required in staging and production.
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/rarecity

# --- Tests (npm run test:server) --------------------------------------------------------

# Disposable database for migration tests. Its name must end in _test and it must not be
# DATABASE_URL. Without it the database tests skip (or fail, with REQUIRE_DB_TESTS=1).
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/rarecity_test

# --- Client build -----------------------------------------------------------------------

# local-demo (default): the engine and the city live in the browser.
# VITE_APP_MODE=local-demo
